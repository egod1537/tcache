NODE_ENV=development
TCACHE_PORT=3200
TCACHE_TESTBED_PORT=3201
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=
DATABASE_URL=
GIT_COMMIT_SHA=dev
ROUTE_JOB_TTL_SECONDS=86400
ROUTE_CACHE_TTL_SECONDS=3600
ROUTE_PROVIDER_TIMEOUT_MS=30000
TCACHE_MATRIX_CONCURRENCY=4
ROUTE_PROVIDER=mock
JAPAN_TRANSIT_PROVIDER=ekispert
ROUTE_PROVIDER_OVERRIDE_ENABLED=true
ROUTE_PROVIDER_RAW_DEBUG_ENABLED=true
ROUTE_TIME_ZONE=Asia/Seoul
AI_JOB_TTL_SECONDS=86400
AI_CACHE_DEFAULT_TTL_SECONDS=3600
AI_PROVIDER_TIMEOUT_MS=120000
AI_PROVIDER=mock
GEMINI_MODEL=gemini-3.6-flash
# For OpenWebUI on the macOS Docker host, for example: http://host.docker.internal:3000
OPENWEBUI_BASE_URL=
# Optional when the OpenWebUI instance accepts unauthenticated requests.
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=

# Required when ROUTE_PROVIDER=google or auto selects Google.
GOOGLE_MAPS_API_KEY=
# Required when auto routing selects Kakao Maps (KR transit/walking/bicycle).
KAKAO_REST_API_KEY=
# Required when auto routing selects Kakao Mobility (KR driving).
KAKAO_MOBILITY_API_KEY=
# Required when JAPAN_TRANSIT_PROVIDER=navitime or provider override selects it.
NAVITIME_API_KEY=
NAVITIME_API_BASE_URL=https://navitime-route-totalnavi.p.rapidapi.com
# Required when auto routing selects Ekispert (JP transit, Standard/Trial only).
EKISPERT_API_KEY=
EKISPERT_API_BASE_URL=https://api.ekispert.jp
# Experimental self-hosted OpenTripPlanner provider (disabled by default).
OTP_BASE_URL=http://localhost:8080
OTP_PROVIDER_ENABLED=false
OTP_REQUEST_TIMEOUT_MS=30000
OTP_VERSION=2.10.0
# Change this value after every graph rebuild to invalidate OTP route cache entries.
OTP_GRAPH_BUILD_ID=
OTP_GTFS_DATASET_VERSION=
OTP_OSM_DATASET_VERSION=
# Optional browser-exposed key used only to render the /route map.
# Restrict this key to the Maps JavaScript API and allowed web origins.
VITE_GOOGLE_MAPS_API_KEY=
# Required when AI_PROVIDER=gemini.
GEMINI_API_KEY=
